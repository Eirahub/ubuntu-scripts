# Mal for .env (kopier til .env og fyll inn). .env står i .gitignore og skal aldri i repoet.

# Wifi
WIFI_SSID=""
WIFI_PASSWORD=""

# Admin-kontoene (med sudo)
ADMIN_USER_PREFIX="pc-"
ADMIN_PASSWORD=""

# Elevbrukeren (ikke admin, logges inn automatisk)
ELEV_USER="bruker"
ELEV_PASSWORD=""

# Fjernstyring: RustDesk-passordet (minst 8 tegn) og en Tailscale auth-nøkkel (gjenbrukbar, med tag:kodeklubb)
RUSTDESK_PASSWORD=""
TAILSCALE_AUTHKEY=""

# SSH fra admin-PC-en
SSH_KEY="~/.ssh/id_ed25519"
HOST_PREFIX="eira-pc-"
HOST_SUFFIX=".local"
HOSTS="01 02 03 04 05 06 07 08"
